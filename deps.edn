{:paths ["src"]
 :deps {com.taoensso/timbre {:mvn/version "6.8.0"}
        io.github.borkdude/deflet {:mvn/version "0.1.0"}
        methodical/methodical {:mvn/version "1.0.127"}
        org.clojure/clojure {:mvn/version "1.12.6"}
        org.babashka/cli {:mvn/version "0.12.91"}
        tesser.core/tesser.core {:mvn/version "1.0.9"}}
 :aliases {:dev {:extra-paths ["dev" "test"]
                 :extra-deps {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.8.0"}}
                 :jvm-opts ["-Djdk.attach.allowAttachSelf"]}
           :patches {:extra-paths ["patches"]
                     :extra-deps {com.cnuernber/ham-fisted {:mvn/version "3.035"}}}
           :exec {:main-opts ["-m" "babashka.cli.exec"]}
           :maths {:jvm-opts ["--add-exports=java.base/jdk.internal.ref=ALL-UNNAMED"
                              "--add-exports=java.base/sun.nio.ch=ALL-UNNAMED"]
                   :extra-deps {cnuernber/dtype-next {:mvn/version "11.026"}
                                org.slf4j/slf4j-simple {:mvn/version "2.0.20"}
                                org.uncomplicate/neanderthal-base {:mvn/version "0.66.1"}
                                org.uncomplicate/neanderthal-mkl {:mvn/version "0.66.1"}}}
           :mkl {:extra-deps {org.bytedeco/mkl {:mvn/version "2026.1-1.5.14"}
                              org.bytedeco/javacpp {:mvn/version "1.5.14"}}}
           :mkl-linux {:extra-deps {org.bytedeco/mkl$linux-x86_64-redist
                                    {:mvn/version "2026.1-1.5.14"}}}
           :mkl-windows {:extra-deps {org.bytedeco/mkl$windows-x86_64-redist
                                      {:mvn/version "2026.1-1.5.14"}}}
           :test
           {:exec-fn cognitect.test-runner.api/test
            :extra-deps {io.github.cognitect-labs/test-runner
                         {:git/sha "3f288f1f16d167723ad87cc35b1dfee3c1681e10"}}
            :extra-paths ["test"]
            :jvm-opts ["-Dtaoensso.timbre.config.edn={:min-level :info}"]
            :main-opts ["-m" "cognitect.test-runner"]}
           :clojure-mcp
           {:deps {org.slf4j/slf4j-nop {:mvn/version "2.0.17"} ;; Required for stdio server
                   com.bhauman/clojure-mcp {:git/url "https://github.com/bhauman/clojure-mcp.git"
                                            :git/tag "v0.1.11-alpha"
                                            :git/sha "7739dba"}}
            :exec-fn clojure-mcp.main/start-mcp-server
            :exec-args {:port 7888}}}}
